# Render (API service)
NODE_ENV=production
PORT=3001

# Supabase > Project Settings > Database > Connection string (URI, pooler recommended)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Generate a long random secret for production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Vercel production URL, plus optional preview wildcard
CORS_ORIGIN=https://your-app.vercel.app,*.vercel.app

# Keep false when the frontend is hosted on Vercel
SERVE_FRONTEND=false
