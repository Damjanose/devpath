NODE_ENV=development
PORT=3001

# Supabase pooler connection (Settings > Database > Connection string > URI)
# Important for Render: paste only the URI value (no labels/text) and keep it on one line.
# Add sslmode=require for production.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

JWT_SECRET=devpath-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8080
