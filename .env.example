# Vercel (frontend build)
# Supabase > Project Settings > API
VITE_SUPABASE_URL="https://projectId.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="publishableKey"

# Render > Web Service public URL (append /api automatically if omitted)
VITE_API_URL="https://your-api.onrender.com"

# Optional metadata only; the app does not read this in src/
VITE_SUPABASE_PROJECT_ID="projectId"

# Local dev: leave VITE_API_URL unset to use the Vite /api proxy.
